# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
rule
echo -e "${BOLD}Summary${R}"
rule
echo -e "  Total   : $TOTAL"
echo -e "  ${GREEN}Done    : $DONE${R}"
[[ $SKIPPED -gt 0 ]] && echo -e "  ${YELLOW}Skipped : $SKIPPED (no subtitles found)${R}"
