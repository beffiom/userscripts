    done
  done
)

if [[ ${#VIDEO_FILES[@]} -eq 0 ]]; then
  warn "No video files found in $TARGET_DIR"
  exit 0
fi

echo -e "Found ${BOLD}${#VIDEO_FILES[@]}${R} video file(s)\n"
TOTAL=${#VIDEO_FILES[@]}

for video in "${VIDEO_FILES[@]}"; do
  process_video "$video" "$BACKUP_DIR" || {
    err "Unhandled error processing: $(basename "$video")"
    ((FAILED++)) || true
    FAILED_FILES+=("$(basename "$video")")
  }
